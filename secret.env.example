# Reddit "script" app credentials.
# Create at: https://www.reddit.com/prefs/apps -> "create an app" -> type "script"
# client_id is the unlabeled string under the app name; secret is the labeled field.
# 2FA must be OFF on this account (password-grant auth doesn't support it).
REDDIT_CLIENT_ID=CHANGEME
REDDIT_CLIENT_SECRET=CHANGEME
REDDIT_USERNAME=CHANGEME
REDDIT_PASSWORD=CHANGEME

# Basic Auth for the viewer (enforced by Caddy itself via the Caddyfile
# template rendered at pod start - see viewer/Caddyfile).
VIEWER_BASIC_AUTH_USERNAME=CHANGEME

# bcrypt hash, NOT the plaintext password. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password-here'
VIEWER_BASIC_AUTH_PASSWORD_HASH=CHANGEME
