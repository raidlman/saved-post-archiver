# User-Agent Reddit's API rules require: unique and descriptive, not a
# default/library string. Format: platform:appid:version (by /u/username)
REDDIT_USER_AGENT=linux:reddit-archiver:v1.0 (by /u/CHANGEME)

# Max posts unsaved per run (newest-first, only fully-verified archives).
# Keep small/conservative - see reddit-archiver plan for rationale.
UNSAVE_BATCH_SIZE=10

# Videos larger than this are skipped (marked partial) rather than filling
# the PVC with a handful of huge files.
MAX_VIDEO_SIZE_MB=2048

# python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Extra jitter (seconds) between per-submission API calls, on top of PRAW's
# own rate-limit throttling - avoids a bursty/automated-looking pattern.
REQUEST_JITTER_MIN_SECONDS=1.5
REQUEST_JITTER_MAX_SECONDS=4.0

# Set to "true" to run read-only: no media written, no unsave() calls.
DRY_RUN=false

DATA_DIR=/data
